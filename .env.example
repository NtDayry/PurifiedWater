# =========================================
# Application Metadata
# =========================================
APP_NAME=OCR Service
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=false

# =========================================
# Server Configuration
# =========================================
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# =========================================
# Database Configuration
# =========================================
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>/<db>

# =========================================
# Redis Configuration
# =========================================
# URL to connect to Redis (async redis client). Example: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# =========================================
# JWT / Auth Configuration
# =========================================
# SECRET_KEY should be set via environment in production. Default is insecure placeholder for dev.
SECRET_KEY=dev-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS= 7

# =========================================
# Admin Bootstrap Configuration
# กำหนด default admin user สำหรับ fresh install (ตาราง users ว่างเปล่า)
# เลียนแบบ POSTGRES_USER / POSTGRES_PASSWORD ของ PostgreSQL
# ถ้าไม่กำหนด → ใช้ค่า default: username=admin, password=admin, role=super admin
# password จะถูก hash ด้วย bcrypt ก่อน insert ลง database เสมอ
# =========================================
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=admin
APP_ADMIN_ROLE=super admin

# =========================================
# SMTP / Email Notification Configuration (Gmail)
# =========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=Purifield Water Alarm System
SMTP_TLS=true
